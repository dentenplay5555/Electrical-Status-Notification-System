{
  "name": "appliance-notifier-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test test/worker.test.mjs test/resilience.test.mjs",
    "db:migrate": "wrangler d1 execute appliance-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute appliance-db --remote --file=./schema.sql",
    "db:drop-index:remote": "wrangler d1 execute appliance-db --remote --file=./migrations/001_drop_sensor_time_index.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.5.0",
    "wrangler": "^3.114.17"
  }
}
